# Copy to .env on the droplet (`cp .env.example .env && chmod 600 .env`) and replace every value
# with a long random password, e.g. `openssl rand -base64 32`. Never commit .env.
# The role passwords are read only when the data volume is first created; to change one later,
# use `ALTER ROLE ... PASSWORD` (see README.md).

# Bootstrap superuser (container socket only).
POSTGRES_SUPERUSER_PASSWORD=change-me
# Runs migrations (`pnpm db:migrate` through the SSH tunnel).
GIS_OWNER_PASSWORD=change-me
# The API's role.
GIS_APP_PASSWORD=change-me
# The data dashboard's read-only role.
GIS_READONLY_PASSWORD=change-me

# Host port for Postgres, bound to 127.0.0.1 only.
DB_HOST_PORT=5432
