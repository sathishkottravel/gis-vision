# Copy to .env for local development: `cp .env.example .env`
# Values below match docker-compose.yml. Never commit real credentials.

# --- API server (apps/api) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=2000

# --- PostgreSQL + PostGIS (docker compose service: db) ---
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis
POSTGRES_DB=gis_vision
POSTGRES_PORT=5432
DATABASE_URL=postgres://gis:gis@localhost:5432/gis_vision

# --- pgAdmin (docker compose profile: tools) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- S3-compatible object storage (docker compose service: rustfs) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=captures
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin-secret
# RustFS and MinIO-style stores need path-style URLs; AWS S3 does not.
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Capture uploads (presigned URLs) ---
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=900
IMAGE_URL_TTL_SECONDS=300
